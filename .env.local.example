# OpenAI API key — powers AI food-photo analysis and coaching advice.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_TEXT_MODEL=gpt-4o

# Database. Leave both unset for local dev — the app falls back to a local
# SQLite file (fitness.db). Required on Vercel (or any host without a
# writable, persistent local disk): create a free database at
# https://turso.tech, then run `turso db show <db-name> --url` and
# `turso db tokens create <db-name>` to get these.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=

# Optional: connect Fitbit for automatic steps/sleep sync.
# Register an app at https://dev.fitbit.com/apps/new
# Redirect URI to register: http://localhost:3000/api/wearables/fitbit/callback
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=

# Optional: connect Google Fit for automatic steps sync.
# Register an app at https://console.cloud.google.com/apis/credentials
# Redirect URI to register: http://localhost:3000/api/wearables/google_fit/callback
# GOOGLE_FIT_CLIENT_ID=
# GOOGLE_FIT_CLIENT_SECRET=

# Apple Health has no cloud API — import export.xml from Settings instead.
# Garmin requires a negotiated Health API partnership, not covered here.
